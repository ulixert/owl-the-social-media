# Copy to .env.test and fill in your local Postgres credentials.
# Tests run against a SEPARATE database (note the _test suffix) and will
# create/truncate it freely — never point this at your dev database.
DATABASE_URL="postgresql://owl:<password>@localhost:5432/owl_test?schema=public"
ACCESS_TOKEN_SECRET="test-access-secret-not-for-production"
REFRESH_TOKEN_SECRET="test-refresh-secret-not-for-production"
REDIS_URL="redis://localhost:6379"
# Point search at a dead port so the read path deterministically falls back to
# the Postgres ILIKE query (which sees owl_test). A real ES is fed from the dev
# DB via CDC, so search tests must not depend on it. ECONNREFUSED is immediate.
ELASTICSEARCH_URL="http://localhost:9201"
